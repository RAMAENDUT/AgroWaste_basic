  #<span class=sf-dump-protected title=\"Protected property\">escapeWhenCastingToString</span>: <span class=sf-dump-const>false</span>
  #<span class=sf-dump-protected title=\"Protected property\">attributes</span>: <span class=sf-dump-note>array:11</span> [<samp data-depth=2 class=sf-dump-compact>
    \"<span class=sf-dump-key>id</span>\" => \"<span class=sf-dump-str>3</span>\"
    \"<span class=sf-dump-key>title</span>\" => \"<span class=sf-dump-str title=\"23 characters\">Pengolahan Pakan Ternak</span>\"
    \"<span class=sf-dump-key>slug</span>\" => \"<span class=sf-dump-str title=\"23 characters\">pengolahan-pakan-ternak</span>\"
    \"<span class=sf-dump-key>description</span>\" => \"<span class=sf-dump-str title=\"63 characters\">Cara mengolah limbah pertanian menjadi pakan ternak berkualitas</span>\"
    \"<span class=sf-dump-key>content</span>\" => \"\"\"
      <span class=sf-dump-str title=\"1617 characters\">&lt;h2&gt;Pengolahan Limbah Pertanian Menjadi Pakan Ternak&lt;/h2&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1617 characters\">&lt;p&gt;Limbah pertanian seperti jerami, tongkol jagung, dan dedak dapat diolah menjadi pakan ternak yang bergizi dan ekonomis.&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1617 characters\"><span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1617 characters\">&lt;h3&gt;Jenis Pakan dari Limbah&lt;/h3&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1617 characters\">&lt;ul&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1617 characters\">    &lt;li&gt;&lt;strong&gt;Silase:&lt;/strong&gt; Fermentasi hijauan pakan dalam kondisi anaerob&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1617 characters\">    &lt;li&gt;&lt;strong&gt;Hay:&lt;/strong&gt; Hijauan pakan yang dikeringkan&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1617 characters\">    &lt;li&gt;&lt;strong&gt;Pakan Fermentasi:&lt;/strong&gt; Pakan yang difermentasi dengan probiotik&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1617 characters\">    &lt;li&gt;&lt;strong&gt;Pakan Konsentrat:&lt;/strong&gt; Campuran limbah dengan nilai gizi tinggi&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1617 characters\">&lt;/ul&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1617 characters\"><span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1617 characters\">&lt;h3&gt;Pembuatan Pakan Fermentasi&lt;/h3&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1617 characters\">&lt;p&gt;&lt;strong&gt;Bahan-bahan:&lt;/strong&gt;&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1617 characters\">&lt;ul&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1617 characters\">    &lt;li&gt;Jerami padi atau tongkol jagung cacah - 100 kg&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1617 characters\">    &lt;li&gt;Dedak halus - 10 kg&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1617 characters\">    &lt;li&gt;Molases atau gula merah - 2 kg&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1617 characters\">    &lt;li&gt;EM4 atau probiotik - 500 ml&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1617 characters\">    &lt;li&gt;Air bersih - 30-40 liter&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1617 characters\">    &lt;li&gt;Garam - 200 gram&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1617 characters\">&lt;/ul&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1617 characters\"><span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1617 characters\">&lt;p&gt;&lt;strong&gt;Cara Pembuatan:&lt;/strong&gt;&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1617 characters\">&lt;ol&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1617 characters\">    &lt;li&gt;Cacah jerami atau tongkol jagung hingga ukuran 3-5 cm&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1617 characters\">    &lt;li&gt;Larutkan molases, EM4, dan garam dalam air&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1617 characters\">    &lt;li&gt;Campurkan semua bahan, siram dengan larutan secara merata&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1617 characters\">    &lt;li&gt;Masukkan dalam drum atau kantong plastik, padatkan dan tutup rapat&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1617 characters\">    &lt;li&gt;Fermentasi selama 7-14 hari&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1617 characters\">    &lt;li&gt;Pakan siap diberikan dengan bau harum khas fermentasi&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1617 characters\">&lt;/ol&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1617 characters\"><span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1617 characters\">&lt;h3&gt;Keuntungan Pakan Fermentasi&lt;/h3&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1617 characters\">&lt;ul&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1617 characters\">    &lt;li&gt;Nilai gizi lebih tinggi&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1617 characters\">    &lt;li&gt;Mudah dicerna ternak&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1617 characters\">    &lt;li&gt;Dapat disimpan lebih lama&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1617 characters\">    &lt;li&gt;Menghemat biaya pakan hingga 30-40%&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
