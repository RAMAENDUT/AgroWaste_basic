    \"<span class=sf-dump-key>id</span>\" => \"<span class=sf-dump-str>2</span>\"
    \"<span class=sf-dump-key>title</span>\" => \"<span class=sf-dump-str title=\"22 characters\">Pembuatan Pupuk Kompos</span>\"
    \"<span class=sf-dump-key>slug</span>\" => \"<span class=sf-dump-str title=\"22 characters\">pembuatan-pupuk-kompos</span>\"
    \"<span class=sf-dump-key>description</span>\" => \"<span class=sf-dump-str title=\"58 characters\">Teknik dan cara membuat pupuk kompos dari limbah pertanian</span>\"
    \"<span class=sf-dump-key>content</span>\" => \"\"\"
      <span class=sf-dump-str title=\"1618 characters\">&lt;h2&gt;Pembuatan Pupuk Kompos dari Limbah Pertanian&lt;/h2&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1618 characters\">&lt;p&gt;Pupuk kompos adalah pupuk organik hasil penguraian bahan-bahan organik oleh mikroorganisme. Kompos sangat bermanfaat untuk menyuburkan tanah.&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1618 characters\"><span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1618 characters\">&lt;h3&gt;Bahan-Bahan yang Diperlukan&lt;/h3&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1618 characters\">&lt;ul&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1618 characters\">    &lt;li&gt;Limbah pertanian (jerami, daun, batang tanaman) - 100 kg&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1618 characters\">    &lt;li&gt;Kotoran hewan - 25 kg&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1618 characters\">    &lt;li&gt;EM4 atau aktivator kompos - 1 liter&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1618 characters\">    &lt;li&gt;Air secukupnya&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1618 characters\">    &lt;li&gt;Dedak atau bekatul - 5 kg&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1618 characters\">&lt;/ul&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1618 characters\"><span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1618 characters\">&lt;h3&gt;Langkah-Langkah Pembuatan&lt;/h3&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1618 characters\">&lt;ol&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1618 characters\">    &lt;li&gt;&lt;strong&gt;Persiapan Bahan:&lt;/strong&gt; Cacah limbah pertanian hingga ukuran 2-5 cm untuk mempercepat proses pengomposan&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1618 characters\">    &lt;li&gt;&lt;strong&gt;Pencampuran:&lt;/strong&gt; Campurkan semua bahan secara merata, siram dengan larutan EM4 yang sudah dicampur air&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1618 characters\">    &lt;li&gt;&lt;strong&gt;Penyusunan Tumpukan:&lt;/strong&gt; Susun campuran dengan tinggi sekitar 1 meter, bentuk menyerupai gunung&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1618 characters\">    &lt;li&gt;&lt;strong&gt;Penutupan:&lt;/strong&gt; Tutup tumpukan dengan terpal atau karung goni untuk menjaga kelembaban&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1618 characters\">    &lt;li&gt;&lt;strong&gt;Pembalikan:&lt;/strong&gt; Balik tumpukan setiap 3-4 hari sekali untuk aerasi&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1618 characters\">    &lt;li&gt;&lt;strong&gt;Pemantauan:&lt;/strong&gt; Jaga kelembaban sekitar 50-60%, jika terlalu kering siram dengan air&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1618 characters\">    &lt;li&gt;&lt;strong&gt;Panen:&lt;/strong&gt; Setelah 3-4 minggu, kompos siap digunakan (berwarna coklat kehitaman, berbau tanah)&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1618 characters\">&lt;/ol&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1618 characters\"><span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1618 characters\">&lt;h3&gt;Tips Keberhasilan&lt;/h3&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1618 characters\">&lt;ul&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1618 characters\">    &lt;li&gt;Perbandingan bahan hijau dan coklat harus seimbang (1:2)&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1618 characters\">    &lt;li&gt;Jaga kelembaban tetap stabil&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1618 characters\">    &lt;li&gt;Pastikan aerasi cukup dengan pembalikan rutin&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1618 characters\">    &lt;li&gt;Suhu ideal pengomposan 40-60&#176;C&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1618 characters\">&lt;/ul&gt;</span>
      \"\"\"
